# syntax=docker/dockerfile:1
#
# The CUDA 12 image, for linux/amd64. Build it with `make image-cuda`. It needs
# the NVIDIA Container Toolkit and `docker run --gpus all`. Speech-to-text and
# text-to-speech run on the GPU; the wake word and VAD stay on the CPU.
#
# Mounts and VERSION: as in Dockerfile.cpu. The base matches talkie-core's
# tested baseline: ONNX Runtime 1.22.0 with CUDA 12 and cuDNN 9.

ARG ORT_VERSION=1.22.0
# Go 1.26: bytedance/sonic, which eino uses for JSON, supports Go up to 1.26
# and warns at every start on a newer one.
ARG GO_IMAGE=golang:1.26-bookworm
ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

# Built on Debian 12, whose glibc is older than the runtime's Ubuntu 24.04.
FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
	set -eux; \
	install -D -m 0755 "$(go list -m -f '{{.Dir}}' github.com/androiddrew/talkie-core)/scripts/get-assets.sh" /out/get-assets.sh; \
	CGO_ENABLED=1 go build -trimpath -ldflags "-s -w" -o /out/example-eino-talkie-agent .

FROM ${GO_IMAGE} AS onnxruntime
ARG ORT_VERSION
ARG ORT_SHA256=2a19dbfa403672ec27378c3d40a68f793ac7a6327712cd0e8240a86be2b10c55
RUN set -eux; \
	curl -fsSL -o /ort.tgz "https://github.com/microsoft/onnxruntime/releases/download/v$ORT_VERSION/onnxruntime-linux-x64-gpu-$ORT_VERSION.tgz"; \
	echo "$ORT_SHA256  /ort.tgz" | sha256sum -c -; \
	mkdir /onnxruntime; \
	tar xzf /ort.tgz --no-same-owner --strip-components=1 -C /onnxruntime

FROM ${CUDA_IMAGE}
ARG ORT_VERSION
ARG VERSION=devel
LABEL org.opencontainers.image.title="eino-talkie-agent" \
	org.opencontainers.image.description="A voice agent: talkie-core and an eino agent, on NVIDIA GPUs" \
	org.opencontainers.image.source="https://github.com/androiddrew/example-eino-talkie-agent" \
	org.opencontainers.image.version="$VERSION" \
	org.opencontainers.image.licenses="Apache-2.0"
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends ca-certificates curl libasound2t64 libpulse0 python3; \
	rm -rf /var/lib/apt/lists/*; \
	useradd --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin talkie

ARG DOCS=/usr/share/doc/eino-talkie-agent
COPY LICENSE NOTICE THIRD_PARTY.md $DOCS/
COPY --from=onnxruntime /onnxruntime/LICENSE /onnxruntime/ThirdPartyNotices.txt $DOCS/onnxruntime/
RUN ln -s /NGC-DL-CONTAINER-LICENSE "$DOCS/NGC-DL-CONTAINER-LICENSE"
# The CUDA provider is loaded from beside libonnxruntime.
COPY --from=onnxruntime \
	/onnxruntime/lib/libonnxruntime.so.$ORT_VERSION \
	/onnxruntime/lib/libonnxruntime_providers_shared.so \
	/onnxruntime/lib/libonnxruntime_providers_cuda.so \
	/opt/onnxruntime/lib/
COPY --from=build /out/get-assets.sh /usr/local/bin/get-assets.sh
COPY --from=build /out/example-eino-talkie-agent /usr/local/bin/example-eino-talkie-agent

ENV XDG_CONFIG_HOME=/config \
	XDG_DATA_HOME=/data \
	HOME=/tmp \
	EINO_TALKIE_CUDA=true \
	EINO_TALKIE_ORT=/opt/onnxruntime/lib/libonnxruntime.so.$ORT_VERSION \
	EINO_TALKIE_DATA=/data/eino-talkie-agent \
	EINO_TALKIE_PARAKEET=/data/eino-talkie-agent/parakeet \
	EINO_TALKIE_KOKORO=/data/eino-talkie-agent/kokoro \
	EINO_TALKIE_SKILLS=/config/eino-talkie-agent/skills
USER talkie
WORKDIR /tmp
ENTRYPOINT ["example-eino-talkie-agent"]
