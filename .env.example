# Copy to .env, next to compose.yaml. Compose reads it; nothing else does.

# Required: SearXNG's secret key, such as the output of openssl rand -hex 32.
SEARXNG_SECRET=

# The agent runs as you: id -u and id -g, if they aren't 1000.
#TALKIE_UID=1000
#TALKIE_GID=1000

# Where the models are on this machine, if not ~/.local/share/eino-talkie-agent.
#TALKIE_DATA=/data/talkie

# A GPU: uncomment one. On a Jetson, TALKIE_JETSON picks the image.
#COMPOSE_FILE=compose.yaml:docker/compose.cuda.yaml
#COMPOSE_FILE=compose.yaml:docker/compose.jetson.yaml
#TALKIE_JETSON=jetson-xavier        # or jetson-orin

# No sound server, as on a headless Jetson: add :docker/compose.alsa.yaml to
# COMPOSE_FILE (compose.yaml:docker/compose.alsa.yaml without a GPU), and set
# the host's audio group: getent group audio | cut -d: -f3.
#TALKIE_AUDIO_GID=29
