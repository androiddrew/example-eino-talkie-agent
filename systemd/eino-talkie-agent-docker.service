# The agent's compose stack (compose.yaml: the agent and SearXNG) as a
# systemd user service. Starting it from your session, rather than with
# Docker's restart policies, waits for the sound server that the agent
# connects to. Set WorkingDirectory to your checkout, where .env is, then
#
#   mkdir -p ~/.config/systemd/user
#   cp eino-talkie-agent-docker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now eino-talkie-agent-docker
#
# and follow it with `journalctl --user-unit eino-talkie-agent-docker -f`.
# `sudo loginctl enable-linger $USER` starts it at boot, before you log in.

[Unit]
Description=eino-talkie-agent, a voice agent, in Docker
Documentation=https://github.com/androiddrew/example-eino-talkie-agent
After=pipewire.service pipewire-pulse.service wireplumber.service pulseaudio.service

[Service]
Type=exec
WorkingDirectory=%h/example-eino-talkie-agent
ExecStart=/usr/bin/docker compose up --no-log-prefix agent
ExecStop=/usr/bin/docker compose stop agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
